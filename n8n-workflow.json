    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an AI Lead Analyzer for a business.\n\nAnalyze the lead information provided below.\n\nIMPORTANT:\n\nTreat the Lead Information below as the complete source of truth.\nIf Name, Company, or Website contains a value, treat that information as PROVIDED and DO NOT say it is missing.\nOnly say that Name, Company, or Website is missing if its actual value is empty, blank, null, or not provided.\nDo not assume a field is missing just because the value is short, generic, or uses a common email provider.\nDo not invent facts.\nDo not make unsupported assumptions.\nBase your analysis ONLY on the provided lead information.\n\nEvaluate the lead based on:\n\nLead Qualification\nLead Score\nCustomer Intent\nBusiness Need\nRecommended Action\nReason\n\nReturn ONLY valid JSON in exactly this format:\n\n{\n\"lead_qualification\": \"\",\n\"lead_score\": 0,\n\"customer_intent\": \"\",\n\"business_need\": \"\",\n\"recommended_action\": \"\",\n\"reason\": \"\"\n}\n\nLead Score must be a number from 0 to 100.\n\nLead Information:\n\nName: {{ $json.name }}\nEmail: {{$json.Email}}\nCompany: {{ $json['Company Name'] }}\nWebsite: {{ $json['Company Website'] }}\nBusiness Description: {{$json[\"Business Description\"]}}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [-240, 16],
      "id": "a4842d87-8b84-477f-8864-7e7437ed9fb9",
      "name": "AI Lead Analyzer"
    },
    {
      "parameters": {
        "fromEmail": "YOUR_SENDER_EMAIL@example.com",
        "toEmail": "YOUR_SALES_EMAIL@example.com",
        "subject": "🔥 Hot Lead Alert - Immediate Follow-Up Required",
        "emailFormat": "text",
        "text": "=Hi Sales Team,\n\nA new HOT lead has been identified and requires follow-up.\n\nLead Name: {{ $('Prepare Lead Data').item.json.name }}\nLead Email: {{ $('Prepare Lead Data').item.json.Email }}\nCompany: {{ $('Prepare Lead Data').item.json[\"Company Name\"] }}\nWebsite: {{ $('Prepare Lead Data').item.json[\"Company Website\"] }}\nBusiness Description: {{ $('Prepare Lead Data').item.json[\"Business Description\"] }}\nLead Qualification: {{ $json.lead_qualification }}\nLead Score: {{ $json.lead_score }}/100\nCustomer Intent: {{ $json.customer_intent }}\nBusiness Need: {{ $json.business_need }}\n\nRecommended Action: {{ $json.recommended_action }}\n\nReason:\n{{ $json.reason }}\n\nPlease review the lead and follow up accordingly.\n\nBest regards,\nAI Lead Automation System",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [352, -80],
      "id": "b3aa2739-eed0-4016-b64d-9a47974b5a5e",
      "name": "HOT Email"
    },
    {
      "parameters": {
        "fromEmail": "YOUR_SENDER_EMAIL@example.com",
        "toEmail": "YOUR_CUSTOMER_EMAIL@example.com",
        "subject": "Follow-Up on Your Business Inquiry",
        "emailFormat": "text",
        "text": "=Hi {{ $('Prepare Lead Data').item.json.name }},\n\nThank you for your interest.\n\nWe’d like to learn more about your business and understand your requirements so we can recommend the right solution.\n\nLead Details:\n\nCompany: {{ $('Prepare Lead Data').item.json[\"Company Name\"] }}\nWebsite: {{ $('Prepare Lead Data').item.json[\"Company Website\"] }}\nBusiness Description: {{ $('Prepare Lead Data').item.json[\"Business Description\"] }}\n\nLead Qualification: {{ $json.lead_qualification }}\nLead Score: {{ $json.lead_score }}/100\nCustomer Intent: {{ $json.customer_intent }}\nBusiness Need: {{ $json.business_need }}\n\nRecommended Action:\n{{ $json.recommended_action }}\n\nPlease reply with any additional details about your requirements, and our team will be happy to assist you.\n\nBest regards,\nBusiness Support Team",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [576, 32],
      "id": "cdcc4fdc-2c92-4441-9a59-fecd92941d2e",
      "name": "WARM Email"
    },
    {
      "parameters": {
        "fromEmail": "YOUR_SENDER_EMAIL@example.com",
        "toEmail": "YOUR_CUSTOMER_EMAIL@example.com",
        "subject": "We’d Love to Learn More About Your Business",
        "emailFormat": "text",
        "text": "=Hi {{ $('Prepare Lead Data').item.json.name }},\n\nThank you for reaching out to us.\n\nWe’d be happy to learn more about your business and understand how we can help you.\n\nLead Details:\n\nCompany: {{ $('Prepare Lead Data').item.json[\"Company Name\"] }}\nWebsite: {{ $('Prepare Lead Data').item.json[\"Company Website\"] }}\nBusiness Description: {{ $('Prepare Lead Data').item.json[\"Business Description\"] }}\n\nLead Qualification: {{ $json.lead_qualification }}\nLead Score: {{ $json.lead_score }}/100\nCustomer Intent: {{ $json.customer_intent }}\nBusiness Need: {{ $json.business_need }}\n\nRecommended Action:\n{{ $json.recommended_action }}\n\nReason:\n{{ $json.reason }}\n\nIf you’re interested, please reply with more details about your business requirements. Our team will be happy to assist you.\n\nBest regards,\nBusiness Support Team",
        "options": {}
      },
